# Copy Supabase's direct connection string when the host supports IPv6. Use the
# Session pooler string on an IPv4-only host. Keep sslmode=require.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@HOST:5432/postgres?sslmode=require

# Server-side copies of the same public Auth configuration used by the frontend.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Comma-separated frontend origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173,https://YOUR_VERCEL_DOMAIN.vercel.app
PORT=8080

